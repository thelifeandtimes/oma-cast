#!/bin/bash
# Optional control/diagnostic helper for an Omarchy-managed oma-cast plugin.
# Installation, updates and removal belong to `omarchy plugin`.
set -uo pipefail

PLUGIN_ID="thelifeandtimes.oma-cast"
IPC_TARGET="oma-cast"
plugins_dir="$HOME/.config/omarchy/plugins"

usage() {
  cat <<USAGE
Usage: oma-cast <command> [args]

  toggle                 Show or hide the launcher
  show | hide            Show or hide it
  run <commandId>        Open a command directly
  call <method> [json]   Call a backend method, e.g. oma-cast call system.info
  doctor                 Check the installed plugin and shell

Manage the plugin with Omarchy:
  omarchy plugin install https://github.com/thelifeandtimes/oma-cast.git --enable
  omarchy plugin update $PLUGIN_ID
  omarchy plugin remove $PLUGIN_ID

See README.md for the Hyprland launcher binding. This helper does not need
an entry in PATH; run it from the checkout or installed plugin's bin/ folder.
USAGE
}

die() { echo "oma-cast: $*" >&2; exit 1; }
ipc() { omarchy-shell "$IPC_TARGET" "$@"; }
need_shell() {
  command -v omarchy-shell >/dev/null || die "omarchy-shell not found; oma-cast runs inside the Omarchy shell"
}

cmd_doctor() {
  local bad=0
  check() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"; else printf '  FAIL  %s\n' "$label"; bad=1; fi
  }
  plugin_enabled() { omarchy plugin list --json | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id and .enabled == true)'; }
  plugin_answers() { [[ $(ipc ping) == "ok" ]]; }
  backend_answers() { ipc call system.healthPing '{}' | jq -e '.ok == true'; }

  echo "oma-cast doctor"
  check "omarchy-shell is installed" command -v omarchy-shell
  check "omarchy-shell is running" omarchy-shell shell ping
  check "Hyprland socket is reachable" hyprctl version
  check "plugin manifest is valid" omarchy plugin validate "$plugins_dir/$PLUGIN_ID"
  check "plugin is enabled" plugin_enabled
  check "plugin answers IPC" plugin_answers
  check "backend answers system.healthPing" backend_answers
  return "$bad"
}

case "${1:-}" in
  toggle|show|hide) need_shell; ipc "$1" >/dev/null ;;
  run) need_shell; [[ -n ${2:-} ]] || die "usage: oma-cast run <commandId>"; ipc run "$2" ;;
  call) need_shell; [[ -n ${2:-} ]] || die "usage: oma-cast call <method> [json]"; ipc call "$2" "${3:-}" ;;
  ping) need_shell; ipc ping ;;
  doctor) cmd_doctor ;;
  install) die "use: omarchy plugin install https://github.com/thelifeandtimes/oma-cast.git --enable" ;;
  uninstall) die "use: omarchy plugin remove $PLUGIN_ID" ;;
  reload|dev) die "Omarchy watches the installed checkout; if code remains cached, run: omarchy restart shell" ;;
  setup) die "add the launcher binding from README.md to ~/.config/hypr/bindings.lua" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
